<%--
  공통 <head> (기존 fragments/common.html 의 head(title)).
  include 하기 전에 pageTitle 을 정한다 : <c:set var="pageTitle" value="지도 검색"/>
--%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="ctx" content="<c:url value='/'/>">
  <%-- common.js 가 POST·DELETE 요청 헤더에 CSRF 토큰을 싣는다 --%>
  <c:if test="${not empty _csrf}">
    <meta name="_csrf" content="${_csrf.token}">
    <meta name="_csrf_header" content="${_csrf.headerName}">
  </c:if>
  <title><c:out value="${pageTitle}"/> | 주거환경 취약요인 공간분석</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <link rel="stylesheet" href="<c:url value='/css/app.css'/>">
</head>
